// ========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * NextAuth tables
 */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role UserRole @default(USER)

  createdFromLeadId String?

  accounts              Account[]
  sessions              Session[]
  teamMembers           TeamMember[]
  createdTeams          Team[]                       @relation("TeamCreatedBy")
  refereedFixtures      Fixture[]                    @relation("FixtureReferee")
  enteredResults        MatchResult[]                @relation("ResultEnteredBy")
  createdResultDisputes ResultDispute[]              @relation("ResultDisputeCreatedBy")
  fixtureConfirmations  FixtureCaptainConfirmation[] @relation("FixtureCaptainConfirmationUser")

  assignedMessageThreads MessageThread[] @relation("UserAssignedMessageThreads")
  createdMessageEntries  MessageEntry[]  @relation("UserCreatedMessageEntries")
}

enum UserRole {
  USER
  REFEREE
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * SIXFL league models
 */

model LeagueCompetition {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  area     String?
  dayOfWeek PreferredNight?
  leagueType LeagueType?
  venueName String?
  isActive Boolean @default(true)

  currentLeagueId String?
  currentLeague   League? @relation("CurrentCompetitionLeague", fields: [currentLeagueId], references: [id], onDelete: SetNull)

  leagues League[] @relation("CompetitionSeasons")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([area])
  @@index([dayOfWeek])
  @@index([leagueType])
}

model League {
  id       String  @id @default(cuid())
  name     String
  season   String?
  isActive Boolean @default(true)
  slug     String  @unique

  area         String?
  dayOfWeek    PreferredNight?
  leagueType   LeagueType?
  venueName    String?
  kickoffInfo  String?
  format       String?
  surface      String?
  description  String?
  heroImageUrl String?
  badgeUrl     String?
  ctaText      String?

  competitionId String?
  competition   LeagueCompetition? @relation("CompetitionSeasons", fields: [competitionId], references: [id], onDelete: SetNull)
  currentForCompetitions LeagueCompetition[] @relation("CurrentCompetitionLeague")

  teams          Team[]
  divisions      LeagueDivision[]
  fixtures       Fixture[]
  interestLeads  InterestLead[]
  paymentCharges PaymentCharge[]
  messageThreads MessageThread[] @relation("LeagueMessageThreads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, season])
  @@index([competitionId])
  @@index([competitionId, season])
  @@index([isActive])
  @@index([area])
  @@index([dayOfWeek])
  @@index([leagueType])
}

model LeagueDivision {
  id        String  @id @default(cuid())
  leagueId  String
  name      String
  slug      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  league   League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teams    Team[]
  fixtures Fixture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, slug])
  @@index([leagueId])
  @@index([leagueId, isActive, sortOrder])
}

model Venue {
  id       String  @id @default(cuid())
  name     String
  address  String?
  postcode String?
  notes    String?

  imageUrl      String?
  websiteUrl    String?
  googleMapsUrl String?
  parkingNotes  String?
  pitchNotes    String?
  facilities    String?

  fixtures Fixture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TeamMode {
  STANDARD
  MANAGED
}

enum TeamMoveConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model Team {
  id        String  @id @default(cuid())
  name      String
  claimCode String  @unique
  logoUrl   String?

  teamMode           TeamMode @default(STANDARD)
  isRecruiting       Boolean  @default(false)
  joinSlug           String?  @unique
  squadTargetSize    Int?
  matchdayTargetSize Int?
  managerNotes       String?

  // Administrative tracking only; does not transfer or withdraw the team.
  moveConfirmationStatus    TeamMoveConfirmationStatus @default(PENDING)
  moveConfirmationUpdatedAt DateTime?
  moveConfirmationUpdatedBy String?

  contactName           String?
  contactEmail          String?
  contactPhone          String?
  secondaryContactName  String?
  secondaryContactEmail String?
  secondaryContactPhone String?

  latestKickoffTime     String?
  standardMatchFeePence Int?

  createdByUserId String?
  createdByUser   User?   @relation("TeamCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  leagueId String?
  league   League? @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  divisionId String?
  division   LeagueDivision? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  captainUserId       String?
  captainLinkedAt     DateTime?
  captainLinkedSource String?
  captainInviteSentAt DateTime?
  captainInviteSentTo String?
  captainClaimedAt    DateTime?
  captainClaimSource  String?

  members              TeamMember[]
  prospects            TeamPlayerProspect[]
  homeGames            Fixture[]                    @relation("HomeTeam")
  awayGames            Fixture[]                    @relation("AwayTeam")
  resultMetadata       MatchResultTeamMeta[]
  resultDisputes       ResultDispute[]
  paymentCharges       PaymentCharge[]
  paymentTransactions  PaymentTransaction[]
  playerMatchFees      PlayerMatchFee[]
  fixtureConfirmations FixtureCaptainConfirmation[]

  convertedFromLead InterestLead?   @relation("LeadConvertedTeam")
  messageThreads    MessageThread[] @relation("TeamMessageThreads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, leagueId])
  @@index([leagueId])
  @@index([divisionId])
  @@index([createdByUserId])
  @@index([contactEmail])
  @@index([contactPhone])
  @@index([captainUserId])
  @@index([captainLinkedAt])
  @@index([captainInviteSentAt])
  @@index([captainClaimedAt])
  @@index([teamMode])
  @@index([isRecruiting])
  @@index([joinSlug])
}

model TeamMember {
  id     String   @id @default(cuid())
  userId String
  teamId String
  role   TeamRole @default(MANAGER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  fixtureAvailabilities FixtureAvailability[]
  fixtureSelections     FixtureSelection[]
  playerMatchFees       PlayerMatchFee[]

  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
  @@index([role])
}

model TeamPlayerProspect {
  id String @id @default(cuid())

  teamId String?

  firstName           String
  lastName            String?
  email               String?
  phone               String?
  ageBand             String?
  preferredPositions  String?
  experienceSummary   String?
  availabilityLevel   String?
  preferredNights     Json?
  availabilitySummary String?
  source              String?
  status              String    @default("NEW")
  lastContactedAt     DateTime?
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  playerMatchFees PlayerMatchFee[]

  @@index([teamId, status])
  @@index([email])
  @@index([phone])
  @@index([ageBand])
  @@index([availabilityLevel])
}

enum TeamRole {
  CAPTAIN
  MANAGER
  PLAYER
  COACH
  VICE_CAPTAIN
  BACKUP_PLAYER
}

model Fixture {
  id            String    @id @default(cuid())
  leagueId      String
  divisionId    String?
  homeTeamId    String
  awayTeamId    String
  venueId       String?
  kickoffAt     DateTime
  publishedAt   DateTime?
  matchFeePence Int?

  round    Int?
  position Int?
  pitch    String?
  status   FixtureStatus @default(SCHEDULED)

  refereeId String?

  socialPostType        SocialPostType   @default(NONE)
  socialPostStatus      SocialPostStatus @default(NONE)
  socialCaption         String?
  socialImageUrl        String?
  socialDraftExternalId String?
  socialLastError       String?
  socialNeedsApproval   Boolean          @default(true)
  socialQueuedAt        DateTime?
  socialApprovedAt      DateTime?
  socialPublishedAt     DateTime?

  league               League                       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  division             LeagueDivision?              @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  homeTeam             Team                         @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam             Team                         @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  venue                Venue?                       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  referee              User?                        @relation("FixtureReferee", fields: [refereeId], references: [id], onDelete: SetNull)
  result               MatchResult?
  paymentCharges       PaymentCharge[]
  captainConfirmations FixtureCaptainConfirmation[]
  availabilities       FixtureAvailability[]
  selections           FixtureSelection[]
  playerMatchFees      PlayerMatchFee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId, kickoffAt])
  @@index([divisionId, kickoffAt])
  @@index([leagueId, divisionId, kickoffAt])
  @@index([leagueId, publishedAt, kickoffAt])
  @@index([leagueId, round])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([refereeId])
  @@index([socialPostStatus])
  @@index([socialPostType])
}

enum FixtureStatus {
  SCHEDULED
  COMPLETED
  POSTPONED
  CANCELLED
}

enum SocialPostType {
  NONE
  RESULT
  FIXTURE
  UPDATE
}

enum SocialPostStatus {
  NONE
  QUEUED
  DRAFTED
  APPROVED
  PUBLISHED
  FAILED
}

enum FixtureCaptainConfirmationStatus {
  PENDING
  CONFIRMED
  ISSUE_RAISED
}

model FixtureCaptainConfirmation {
  id String @id @default(cuid())

  fixtureId String
  teamId    String

  status FixtureCaptainConfirmationStatus @default(PENDING)

  note String?

  confirmedAt   DateTime?
  issueRaisedAt DateTime?
  lastChasedAt  DateTime?

  confirmedByUserId String?

  fixture         Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  team            Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  confirmedByUser User?   @relation("FixtureCaptainConfirmationUser", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fixtureId, teamId])
  @@index([fixtureId, status])
  @@index([teamId, status])
  @@index([confirmedByUserId])
  @@index([lastChasedAt])
}

model FixtureAvailability {
  id String @id @default(cuid())

  fixtureId    String
  teamMemberId String
  response     String    @default("NO_RESPONSE")
  note         String?
  respondedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fixture    Fixture    @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, teamMemberId])
  @@index([fixtureId, response])
  @@index([teamMemberId, response])
}

model FixtureSelection {
  id String @id @default(cuid())

  fixtureId       String
  teamMemberId    String
  selectionStatus String  @default("NOT_SELECTED")
  isCaptain       Boolean @default(false)
  isGoalkeeper    Boolean @default(false)
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fixture    Fixture    @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, teamMemberId])
  @@index([fixtureId, selectionStatus])
  @@index([teamMemberId, selectionStatus])
}

model MatchResult {
  id        String @id @default(cuid())
  fixtureId String @unique

  homeScore Int
  awayScore Int

  enteredByUserId String?
  enteredAt       DateTime @default(now())

  isDisputed  Boolean @default(false)
  disputeNote String?

  fixture       Fixture               @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  enteredByUser User?                 @relation("ResultEnteredBy", fields: [enteredByUserId], references: [id], onDelete: SetNull)
  teamMetadata  MatchResultTeamMeta[]
  disputes      ResultDispute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fixtureId])
}

model MatchResultTeamMeta {
  id                String   @id @default(cuid())
  matchResultId     String
  teamId            String
  scorers           Json?
  goalsRecorded     Int      @default(0)
  playerOfMatchName String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  matchResult MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchResultId, teamId])
  @@index([teamId])
}

enum ResultDisputeType {
  SCORE
  PLAYER
  GENERAL
}

enum ResultDisputeStatus {
  OPEN
  REVIEW
  RESOLVED
  REJECTED
}

model ResultDispute {
  id String @id @default(cuid())

  matchResultId String
  teamId        String

  type   ResultDisputeType
  status ResultDisputeStatus @default(OPEN)

  description String
  adminNote   String?

  createdByUserId String?

  matchResult   MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUser User?       @relation("ResultDisputeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchResultId])
  @@index([teamId])
  @@index([status])
  @@index([createdByUserId])
}

enum PaymentChargeStatus {
  OPEN
  PART_PAID
  PAID
  VOID
}

enum PaymentLateFeeStatus {
  NONE
  WARNING
  APPLIED
  WAIVED
}

enum PlayerMatchFeeStatus {
  OPEN
  PAID
  WAIVED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  STRIPE
  CASH
  CARD
  OTHER
}

model PaymentCharge {
  id String @id @default(cuid())

  teamId    String
  leagueId  String?
  fixtureId String?

  title       String
  description String?
  amountPence Int
  dueDate     DateTime?

  status PaymentChargeStatus @default(OPEN)

  latePaymentFeeStatus      PaymentLateFeeStatus @default(NONE)
  latePaymentFeeAmountPence Int                   @default(1000)
  latePaymentFeeNote        String?
  latePaymentFeeWarningAt   DateTime?
  latePaymentFeeAppliedAt   DateTime?
  latePaymentFeeWaivedAt    DateTime?

  paymentToken                  String?   @unique
  lastStripeCheckoutUrl         String?
  lastStripeCheckoutSessionId   String?   @unique
  lastStripeCheckoutCreatedAt   DateTime?
  lastStripeCheckoutAmountPence Int?

  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league  League?  @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  fixture Fixture? @relation(fields: [fixtureId], references: [id], onDelete: SetNull)

  transactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fixtureId, teamId])
  @@index([teamId])
  @@index([leagueId])
  @@index([fixtureId])
  @@index([status])
  @@index([dueDate])
  @@index([latePaymentFeeStatus])
  @@index([dueDate, latePaymentFeeStatus])
}

model PaymentTransaction {
  id String @id @default(cuid())

  teamId   String
  chargeId String?

  amountPence Int
  method      PaymentMethod @default(BANK_TRANSFER)

  reference String?
  notes     String?
  paidAt    DateTime

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?
  stripeChargeId          String?

  team   Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  charge PaymentCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([chargeId])
  @@index([paidAt])
  @@index([method])
}
model PlayerMatchFee {
  id String @id @default(cuid())

  fixtureId String
  teamId    String

  teamMemberId String?
  prospectId   String?

  amountPence Int
  status      PlayerMatchFeeStatus @default(OPEN)

  paymentUrl   String?
  paymentToken String? @unique

  paidAt       DateTime?
  waivedAt     DateTime?
  cancelledAt  DateTime?
  lastChasedAt DateTime?

  note String?

  fixture    Fixture             @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  team       Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamMember TeamMember?         @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  prospect   TeamPlayerProspect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fixtureId, teamMemberId])
  @@unique([fixtureId, prospectId])
  @@index([fixtureId])
  @@index([teamId])
  @@index([teamMemberId])
  @@index([prospectId])
  @@index([status])
}

model InterestLead {
  id           String       @id @default(cuid())
  interestType InterestType
  status       LeadStatus   @default(NEW)

  contactName     String
  email           String?
  phone           String?
  phoneNormalized String?

  teamName   String?
  area       String?
  leagueType LeagueType?
  message    String?

  source           String?
  wantsFreeKit     Boolean @default(false)
  marketingConsent Boolean @default(false)

  leagueId String?
  league   League? @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  contactedAt DateTime?
  closedAt    DateTime?

  convertedAt     DateTime?
  convertedTeamId String?   @unique
  convertedTeam   Team?     @relation("LeadConvertedTeam", fields: [convertedTeamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails          InterestLeadEmail[]
  preferredNights InterestLeadPreferredNight[]

  @@index([interestType])
  @@index([status])
  @@index([area])
  @@index([leagueType])
  @@index([createdAt])
  @@index([leagueId])
  @@index([phoneNormalized])
}

model InterestLeadPreferredNight {
  id        String         @id @default(cuid())
  leadId    String
  night     PreferredNight
  createdAt DateTime       @default(now())

  lead InterestLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, night])
  @@index([leadId])
  @@index([night])
}

model InterestLeadEmail {
  id             String   @id @default(cuid())
  interestLeadId String
  subject        String
  body           String
  sentTo         String
  sentAt         DateTime @default(now())

  interestLead InterestLead @relation(fields: [interestLeadId], references: [id], onDelete: Cascade)

  @@index([interestLeadId])
  @@index([sentAt])
}

model EmailTemplate {
  id           String           @id @default(cuid())
  key          String           @unique
  name         String
  description  String?
  audience     TemplateAudience
  interestType InterestType?
  subject      String
  body         String
  ctaLabel     String?
  ctaUrlKey    String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([audience])
  @@index([interestType])
  @@index([isActive])
}

enum TemplateAudience {
  LEAD
  TEAM
  PLAYER
  REFEREE
  GENERAL
}

enum InterestType {
  TEAM
  PLAYER
  REFEREE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum LeagueType {
  MENS
  WOMENS
  YOUTH
}

enum PreferredNight {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
  ANY
}

/**
 * SIXFL messaging system - stage 1 foundation
 */

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationAudience {
  LEAD
  TEAM
  PLAYER
  REFEREE
  USER
  GENERAL
}

enum NotificationTemplateKind {
  TRANSACTIONAL
  CAMPAIGN
}

enum NotificationRecipientSourceType {
  LEAD
  TEAM
  PLAYER
  REFEREE
  USER
  GENERAL
}

enum NotificationDispatchStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

enum NotificationAttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

/**
 * SIXFL messaging system - stage 2 inbox
 */

enum MessageChannel {
  SMS
  EMAIL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageThreadStatus {
  OPEN
  ARCHIVED
  CLOSED
}

enum MessageParticipantRole {
  ADMIN
  CAPTAIN
  CONTACT
  SYSTEM
}

enum InboxAlertStatus {
  PENDING
  SENT
  READ
  DISMISSED
}

model NotificationRecipient {
  id String @id @default(cuid())

  sourceType NotificationRecipientSourceType
  sourceId   String?

  audience NotificationAudience

  displayName String?
  email       String?
  phone       String?

  emailNormalized String?
  phoneNormalized String?

  marketingEmailOptIn     Boolean @default(false)
  marketingSmsOptIn       Boolean @default(false)
  transactionalEmailOptIn Boolean @default(true)
  transactionalSmsOptIn   Boolean @default(true)

  isSuppressed      Boolean @default(false)
  suppressionReason String?

  metadata     Json?
  lastSyncedAt DateTime?

  preferences    NotificationPreference?
  dispatches     NotificationDispatch[]
  messageThreads MessageThread[]         @relation("NotificationRecipientMessageThreads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([audience])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([isSuppressed])
}

model NotificationPreference {
  id String @id @default(cuid())

  recipientId String @unique

  timezone        String?
  quietHoursStart String?
  quietHoursEnd   String?

  emailEnabled          Boolean @default(true)
  smsEnabled            Boolean @default(true)
  urgentSmsEnabled      Boolean @default(true)
  marketingEmailEnabled Boolean @default(false)
  marketingSmsEnabled   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

model NotificationTemplate {
  id String @id @default(cuid())

  key         String  @unique
  name        String
  description String?

  kind     NotificationTemplateKind @default(TRANSACTIONAL)
  channel  NotificationChannel
  audience NotificationAudience

  subject   String?
  body      String
  ctaLabel  String?
  ctaUrlKey String?

  isActive Boolean @default(true)

  dispatches NotificationDispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channel])
  @@index([audience])
  @@index([kind])
  @@index([isActive])
}

model NotificationDispatch {
  id String @id @default(cuid())

  recipientId String
  templateId  String?

  channel  NotificationChannel
  audience NotificationAudience
  status   NotificationDispatchStatus @default(QUEUED)

  isTransactional Boolean @default(true)

  subject  String?
  bodyText String
  bodyHtml String?

  provider          String?
  providerMessageId String?

  sourceType String?
  sourceId   String?

  variables Json?
  metadata  Json?

  scheduledFor DateTime  @default(now())
  processedAt  DateTime?
  sentAt       DateTime?
  failedAt     DateTime?
  cancelledAt  DateTime?

  failureReason String?

  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient      NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  template       NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  attempts       NotificationAttempt[]
  messageEntries MessageEntry[]        @relation("NotificationDispatchMessageEntries")

  @@index([recipientId])
  @@index([templateId])
  @@index([channel, status])
  @@index([scheduledFor, status])
  @@index([sourceType, sourceId])
  @@index([createdByUserId])
}

model NotificationAttempt {
  id String @id @default(cuid())

  dispatchId String

  provider String
  status   NotificationAttemptStatus @default(PENDING)

  requestPayload  Json?
  responsePayload Json?

  errorMessage String?

  attemptedAt DateTime @default(now())

  dispatch NotificationDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([dispatchId])
  @@index([status])
  @@index([attemptedAt])
}

model MessageThread {
  id String @id @default(cuid())

  channel MessageChannel      @default(SMS)
  status  MessageThreadStatus @default(OPEN)

  recipientId String?
  teamId      String?
  leagueId    String?

  sourceType String?
  sourceId   String?

  contactName        String?
  contactPhone       String?
  phoneNormalized    String?
  contactEmail       String?
  emailNormalized    String?
  replyAddress       String? @unique
  lastMessagePreview String?

  assignedToUserId String?

  latestMessageAt  DateTime?
  latestInboundAt  DateTime?
  latestOutboundAt DateTime?

  unreadForAdminCount   Int @default(0)
  unreadForCaptainCount Int @default(0)

  lastInboundMessageId  String?
  lastOutboundMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient      NotificationRecipient? @relation("NotificationRecipientMessageThreads", fields: [recipientId], references: [id], onDelete: SetNull)
  team           Team?                  @relation("TeamMessageThreads", fields: [teamId], references: [id], onDelete: SetNull)
  league         League?                @relation("LeagueMessageThreads", fields: [leagueId], references: [id], onDelete: SetNull)
  assignedToUser User?                  @relation("UserAssignedMessageThreads", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  messages MessageEntry[]
  alerts   InboxAlert[]

  @@index([recipientId])
  @@index([teamId])
  @@index([leagueId])
  @@index([assignedToUserId])
  @@index([phoneNormalized])
  @@index([emailNormalized])
  @@index([status, latestMessageAt])
  @@index([status, latestInboundAt])
  @@index([unreadForAdminCount, latestInboundAt])
  @@index([sourceType, sourceId])
}

model MessageEntry {
  id String @id @default(cuid())

  threadId String

  channel         MessageChannel         @default(SMS)
  direction       MessageDirection
  participantRole MessageParticipantRole @default(CONTACT)

  body     String
  subject  String?
  textBody String?
  htmlBody String?

  fromNumber String?
  toNumber   String?
  fromEmail  String?
  toEmail    String?

  provider          String?
  providerMessageId String?
  providerStatus    String?

  twilioMessageSid  String?
  twilioAccountSid  String?
  twilioPayload     Json?
  resendEmailId     String?
  resendPayload     Json?
  internetMessageId String?
  inReplyTo         String?
  referencesHeader  String?

  notificationDispatchId String?

  createdByUserId String?

  sentAt     DateTime?
  receivedAt DateTime?
  readAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread        MessageThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  dispatch      NotificationDispatch? @relation("NotificationDispatchMessageEntries", fields: [notificationDispatchId], references: [id], onDelete: SetNull)
  createdByUser User?                 @relation("UserCreatedMessageEntries", fields: [createdByUserId], references: [id], onDelete: SetNull)

  alert InboxAlert?

  @@index([threadId, createdAt])
  @@index([channel, createdAt])
  @@index([direction, createdAt])
  @@index([participantRole, createdAt])
  @@index([providerMessageId])
  @@index([twilioMessageSid])
  @@index([resendEmailId])
  @@index([internetMessageId])
  @@index([fromEmail])
  @@index([toEmail])
  @@index([notificationDispatchId])
  @@index([createdByUserId])
  @@index([receivedAt])
  @@index([sentAt])
}

model InboxAlert {
  id String @id @default(cuid())

  threadId  String
  messageId String @unique

  status InboxAlertStatus @default(PENDING)

  type String

  sentToEmail String?
  emailedAt   DateTime?
  readAt      DateTime?
  dismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread  MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message MessageEntry  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([threadId])
  @@index([type, status])
}
