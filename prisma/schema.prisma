// ========================================
// File: prisma/schema.prisma
// ========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * NextAuth tables
 * (No createdAt/updatedAt on User to avoid db push failure with existing rows)
 */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Platform-level role
  role          UserRole  @default(USER)

  accounts         Account[]
  sessions         Session[]
  teamMembers      TeamMember[]
  refereedFixtures Fixture[]     @relation("FixtureReferee")
  enteredResults   MatchResult[] @relation("ResultEnteredBy")
}

enum UserRole {
  USER
  REFEREE
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * SIXFL league models
 */

model League {
  id        String  @id @default(cuid())
  name      String
  season    String?
  isActive  Boolean @default(true)

  teams     Team[]
  fixtures  Fixture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, season])
}

model Venue {
  id        String  @id @default(cuid())
  name      String
  address   String?
  postcode  String?
  notes     String?

  fixtures  Fixture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id        String @id @default(cuid())
  name      String
  claimCode String @unique
  logoUrl   String?

  leagueId  String?
  league    League? @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  members   TeamMember[]
  homeGames Fixture[] @relation("HomeTeam")
  awayGames Fixture[] @relation("AwayTeam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, leagueId])
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      TeamRole @default(MANAGER)

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, teamId])
}

enum TeamRole {
  MANAGER
  PLAYER
  COACH
}

model Fixture {
  id         String        @id @default(cuid())
  leagueId   String
  homeTeamId String
  awayTeamId String
  venueId    String?
  kickoffAt  DateTime

  round      Int?
  status     FixtureStatus @default(SCHEDULED)

  refereeId  String?

  league     League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  venue      Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  referee    User?  @relation("FixtureReferee", fields: [refereeId], references: [id], onDelete: SetNull)

  result     MatchResult?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([leagueId, kickoffAt])
  @@index([leagueId, round])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([refereeId])
}

enum FixtureStatus {
  SCHEDULED
  COMPLETED
  POSTPONED
  CANCELLED
}

model MatchResult {
  id              String   @id @default(cuid())
  fixtureId       String   @unique

  homeScore       Int
  awayScore       Int

  enteredByUserId String?
  enteredAt       DateTime @default(now())

  isDisputed      Boolean  @default(false)
  disputeNote     String?

  fixture         Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  enteredByUser   User?    @relation("ResultEnteredBy", fields: [enteredByUserId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InterestLead {
  id               String                      @id @default(cuid())
  interestType     InterestType
  status           LeadStatus                  @default(NEW)

  contactName      String
  email            String
  phone            String?

  teamName         String?
  area             String?
  leagueType       LeagueType?
  message          String?

  source           String?
  wantsFreeKit     Boolean                     @default(false)
  marketingConsent Boolean                     @default(false)

  contactedAt      DateTime?
  closedAt         DateTime?

  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  emails           InterestLeadEmail[]
  preferredNights  InterestLeadPreferredNight[]

  @@index([interestType])
  @@index([status])
  @@index([area])
  @@index([leagueType])
  @@index([createdAt])
}

model InterestLeadPreferredNight {
  id        String         @id @default(cuid())
  leadId    String
  night     PreferredNight
  createdAt DateTime       @default(now())

  lead      InterestLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, night])
  @@index([leadId])
  @@index([night])
}

model InterestLeadEmail {
  id             String       @id @default(cuid())
  interestLeadId String
  subject        String
  body           String
  sentTo         String
  sentAt         DateTime     @default(now())

  interestLead   InterestLead @relation(fields: [interestLeadId], references: [id], onDelete: Cascade)

  @@index([interestLeadId])
  @@index([sentAt])
}

enum InterestType {
  TEAM
  PLAYER
  REFEREE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum LeagueType {
  MENS
  WOMENS
  YOUTH
}

enum PreferredNight {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
  ANY
}