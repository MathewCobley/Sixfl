generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

//
// AUTH MODELS
//

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts    Account[]
  sessions    Session[]
  teamMembers TeamMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//
// ENUMS
//

enum ResultStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  DISPUTED
  RESOLVED
  VOID
}

enum TeamResponse {
  PENDING
  CONFIRMED
  DISPUTED
}

enum TeamRole {
  MANAGER
  PLAYER
}

//
// CORE LEAGUE MODELS
//

model Team {
  id       String  @id @default(cuid())
  leagueId String?
  name     String

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  members TeamMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  role      TeamRole @default(PLAYER)
  createdAt DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

model Match {
  id        String   @id @default(cuid())
  leagueId  String?
  seasonId  String?
  kickoffAt DateTime?
  venueId   String?

  homeTeamId String
  awayTeamId String

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)

  result MatchResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId, kickoffAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model MatchResult {
  id      String @id @default(cuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  status ResultStatus @default(DRAFT)

  submittedHome Int?
  submittedAway Int?
  submittedById String?
  submittedAt   DateTime?

  homeResponse    TeamResponse @default(PENDING)
  awayResponse    TeamResponse @default(PENDING)
  homeRespondedAt DateTime?
  awayRespondedAt DateTime?

  disputeReason String?

  finalHome  Int?
  finalAway  Int?
  lockedAt   DateTime?
  lockedById String?

  confirmBy DateTime?

  events ResultEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([confirmBy])
}

model ResultEvent {
  id       String      @id @default(cuid())
  resultId String
  result   MatchResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  type        String
  actorUserId String?
  note        String?
  payloadJson Json?

  createdAt DateTime @default(now())

  @@index([resultId, createdAt])
}
